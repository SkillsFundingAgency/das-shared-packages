@model string
@using System.Security.Claims
@using SFA.DAS.GovUK.SampleSite.ViewDataKeys
@using SFA.DAS.GovUK.SampleSite.Controllers.Routes
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = "GOV.UK One Login Sample Service";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">@ViewData[ViewDataKeys.Title]</h1>

        <p class="govuk-body">
            This sample service uses the GOV Uk One Login to authenticate.
        </p>

        <p>Name: @Context.User.Claims.FirstOrDefault(c => c.Type.Equals(ClaimTypes.Name))?.Value</p>
        <p>Email: @Context.User.Claims.FirstOrDefault(c => c.Type.Equals(ClaimTypes.Email))?.Value</p>
        <p>Sub: @Context.User.Claims.FirstOrDefault(c => c.Type.Equals(ClaimTypes.NameIdentifier))?.Value</p>
        <p>CustomClaim AccountId: @Context.User.Claims.FirstOrDefault(c => c.Type.Equals("CustomClaimId"))?.Value</p>

        <a asp-route="@HomeRoutes.Names.AccountDetails" class="govuk-button">Details</a>
        <a asp-route="@HomeRoutes.Names.ExplainVerify" asp-route-returnUrl="@Model" class="govuk-button">Explain Verify</a>
        <a asp-route="@HomeRoutes.Names.VerifiedAccountDetails" asp-route-returnUrl="@Model" class="govuk-button">Verified Details</a>
    </div>
</div>
